@using RPS.Web.Models.Routing;
@using RPS.Web.Models.ViewModels;
@model RPS.Core.Models.PtItem

<div class="detail-page page">

    <div class="container">
        <div class="row align-items-center justify-content-between">
            <div class="col-auto">
                <div class="frame-details d-flex flex-column align-items-start gap-2" style="width: 700px;">
                    <div class="page-title">
                        <span class="k-icon k-i-edit"></span> @Model.Title
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div style="margin-top: 20px">

            @(Html.Kendo().TabStrip()
        .Name("tabstrip")
        .Items(tabstrip =>
        {
            tabstrip.Add()
    .Text("Form")
    .LinkHtmlAttributes(new { onclick= "pushUrl(\"RPS Project Tracker\", \"/Detail/" + Model.Id + "\")" })
    .LoadContentFrom("DetailsForm", "Detail", Model.Id)
            .Selected(ViewBag.screen == DetailScreenEnum.Form);


            tabstrip.Add()
.Text("Tasks")
.LinkHtmlAttributes(new { onclick = "pushUrl(\"RPS Project Tracker\", \"/Detail/" + Model.Id + "/Tasks\")" })
.LoadContentFrom("TasksForm", "Detail", Model.Id)
.Selected(ViewBag.screen == DetailScreenEnum.Tasks);

            tabstrip.Add()
.Text("Chitchat")
.LinkHtmlAttributes(new { onclick = "pushUrl(\"RPS Project Tracker\", \"/Detail/" + Model.Id + "/Chitchat\")" })
.LoadContentFrom("ChitchatForm", "Detail", Model.Id)
.Selected(ViewBag.screen == DetailScreenEnum.Chitchat);

        })
            )

        </div>
    </div>

    @section styles {
        @Styles.Render("~/Content/detailcss")
        @Styles.Render("~/Content/chitchatcss")
    }

    @section scripts {
        @Html.Partial("_TasksScripts")

        <script>
            function pushUrl(title, url) {
                if ("undefined" !== typeof history.pushState) {
                    history.pushState(null, title, url);
                } else {
                    window.location.assign(url);
                }
            }
        </script>
    }

</div>