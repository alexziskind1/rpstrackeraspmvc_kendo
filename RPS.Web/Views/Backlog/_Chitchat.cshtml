@model RPS.Web.Models.ViewModels.PtItemCommentsVm

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.ItemId)

    <div class="new-comment-form">
        <div class="comment-input-container">
            @Rps.UserAvatar(Model.CurrentUser, "li-avatar rounded")

            @Html.EditorFor(model => model.NewCommentText, new { htmlAttributes = new { @class = "comment-textarea", placeholder = "Enter new comment..." } })

        </div>
        <div class="comment-button-container">
            <button type="submit" class="btn btn-primary">Add Comment</button>
        </div>
    </div>

    <hr />

    <ul class="list-unstyled">
        @foreach (var comment in Model.Comments)
        {

            <li class="chitchat-item">
                <div class="comment-item-container">
                    @Rps.UserAvatar(comment.User, "li-avatar rounded")
                    <div class="media-body">
                        <h6 class="mt-0 mb-1"><span>@comment.User.FullName</span><span class="comment-date">@comment.DateCreated.ToString("MMM d, yyyy")</span></h6>
                        <span type="text" class="chitchat-text">@comment.Title</span>
                    </div>
                </div>
            </li>

        }
    </ul>
}

