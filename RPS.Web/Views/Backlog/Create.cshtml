@model RPS.Web.Models.ViewModels.PtNewItemVm

<div class="page">
    <div class="container">
        <div class="row align-items-center justify-content-between">
            <div class="col-auto">
                <div class="frame-details d-flex flex-column align-items-start gap-2" style="width: 700px;">
                    <div class="page-title">
                        Add New Item
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div style="margin-top: 20px">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group row mb-3">
                    @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @Html.Kendo().TextBoxFor(model => model.Title)
                        @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group row mb-3">
                    @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @Html.Kendo().TextAreaFor(model => model.Description)
                        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group row mb-3">
                    @Html.LabelFor(model => model.TypeStr, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @(Html.Kendo().DropDownListFor(m => m.TypeStr)
                  .BindTo(Model.ItemTypes)
                  .HtmlAttributes(new { style = "width: 100%" })
            )
                        @Html.ValidationMessageFor(model => model.TypeStr, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="offset-sm-2 col-sm-10">
                        <input type="submit" value="Add" class="btn btn-primary" />
                    </div>
                </div>
            }

            <div>
                @Html.ActionLink("Back to List", "Index")
            </div>
        </div>
    </div>
</div>

